[translation]
# LLM provider preset. Supported: deepseek, openai, google, groq, mistral,
# openrouter, siliconflow, zhipu, moonshot, qwen, anthropic
provider = "deepseek"
model = "deepseek-chat"
source_language = "en"
target_language = "ko"
# Or pass --korean-font-zip / set MEOWTH_KOREAN_FONT_ZIP.
# korean_font_zip = "C:/Users/-/Downloads/Galmuri-v2.40.3.zip"

[translation.api]
# Set the actual key in your shell or .env file.
key_env = "DEEPSEEK_API_KEY"
# base_url = "https://api.deepseek.com/v1"

[output]
dir = "outputs"
cache_dir = "work/cache"
